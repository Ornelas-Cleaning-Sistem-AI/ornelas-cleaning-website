---
// Trust strip: four factual promises, each with an inline SVG icon. An
// insurance claim used to sit here and was removed — see the company ledger
// for what has to be true before any such wording ships.
// No numbers, no stat cards — nothing here is a claim we can't back.
---

<section id="trust" class="trust surface-primary" aria-labelledby="trust-title">
  <h2 id="trust-title" class="visually-hidden">Why clients trust Ornelas Cleaning</h2>
  <ul class="trust-list container">
    <li class="trust-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 3 4.5 5.8v5.4c0 4.4 3.2 7.9 7.5 9.3 4.3-1.4 7.5-4.9 7.5-9.3V5.8L12 3Z"/><path d="m9 12 2 2 4-4"/>
      </svg>
      <span>Family-run, owner-operated</span>
    </li>
    <li class="trust-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="9" cy="8" r="3.25"/><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/><path d="M16 4.8a3.25 3.25 0 0 1 0 6.4"/><path d="M17.5 14.3c2.2.5 3.5 2.3 3.5 4.7"/>
      </svg>
      <span>Same team every visit</span>
    </li>
    <li class="trust-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M4 8.5A1.5 1.5 0 0 1 5.5 7H8l1.2-2h5.6L16 7h2.5A1.5 1.5 0 0 1 20 8.5V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8.5Z"/><circle cx="12" cy="13.5" r="3.5"/>
      </svg>
      <span>Photo/video estimate</span>
    </li>
    <li class="trust-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 21s-6.5-5.4-6.5-11a6.5 6.5 0 0 1 13 0c0 5.6-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.5"/>
      </svg>
      <span>Boston &amp; North Shore only</span>
    </li>
  </ul>
</section>

<style>
  .trust {
    padding-block: var(--space-6);
  }

  .trust-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5) var(--space-4);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-on-primary);
  }

  .trust-item .icon {
    width: 28px;
    height: 28px;
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .trust {
      padding-block: var(--space-8);
    }

    .trust-list {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-8);
    }

    .trust-item + .trust-item {
      border-left: 1px solid rgba(255, 255, 255, 0.12);
      padding-left: var(--space-6);
    }
  }
</style>
