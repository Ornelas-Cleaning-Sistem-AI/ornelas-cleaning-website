---
import { Image } from "astro:assets";
import livingRoom01 from "../assets/images/living-room-01.jpg";
import kitchen02 from "../assets/images/kitchen-02.jpg";
import bathroom06 from "../assets/images/bathroom-06-towels.jpg";
import kitchen03 from "../assets/images/kitchen-03.jpg";
import emptyRoom from "../assets/images/empty-room-hardwood.jpg";
import bathroom01 from "../assets/images/bathroom-01.jpg";
import bathroom07 from "../assets/images/bathroom-07-vanity.jpg";
import bedroom02 from "../assets/images/bedroom-02.jpg";
import livingRoom02 from "../assets/images/living-room-02.jpg";
import bathroom02 from "../assets/images/bathroom-02-sink.jpg";
import bathroom03 from "../assets/images/bathroom-03-toilet.jpg";
import bathroom04 from "../assets/images/bathroom-04-shower.jpg";
import kitchen01 from "../assets/images/kitchen-01.jpg";

// Real client-home photos only, in an explicit editorial order. Captions name
// the room and nothing else (never a city, never a client). The 4:3 crop is
// done in CSS with `--pos` (object-position) per photo.
//
// Privacy review (2026-09-11), files deliberately NOT listed here:
// - bedroom-01.jpg: wall sign and wedding canvas with the clients' surname and
//   faces, plus framed photos on both nightstands. A CSS crop would still ship
//   the full file, so the photo is out.
// - kitchen-04-fridge.jpg: party invitation on the fridge door with a child's
//   name, a street address and an RSVP phone number.
// - bathroom-05-tub.jpg: not a bathtub; a "before" shot of a sink with hair and
//   the photographer's thumb in frame. Can't be captioned truthfully as work.
const photos = [
  { src: livingRoom01, caption: "Living room", pos: "50% 42%", feature: true },
  { src: kitchen02, caption: "Kitchen and dining", pos: "50% 45%" },
  { src: bathroom06, caption: "Bathroom", pos: "50% 50%" },
  { src: kitchen03, caption: "Kitchen", pos: "50% 45%" },
  { src: emptyRoom, caption: "Move-out clean", pos: "50% 40%" },
  { src: bathroom01, caption: "Bathroom vanity", pos: "50% 50%" },
  { src: bathroom07, caption: "Bathroom vanity", pos: "50% 50%" },
  { src: bedroom02, caption: "Bedroom", pos: "50% 55%" },
  { src: livingRoom02, caption: "Living room", pos: "50% 50%" },
  { src: bathroom02, caption: "Bathroom sink", pos: "50% 50%" },
  { src: bathroom03, caption: "Bathroom", pos: "50% 50%" },
  { src: bathroom04, caption: "Shower", pos: "50% 50%" },
  { src: kitchen01, caption: "Living room", pos: "50% 45%" },
];
---

<section id="gallery" class="gallery section">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Our Work</p>
      <h2>Real Homes, Real Results</h2>
      <p class="lead text-muted">
        Photos from real cleanings we've done for our clients across Boston
        and the North Shore.
      </p>
    </div>
    <div class="work-grid">
      {
        photos.map((photo) => (
          <figure class:list={["work-item", { "work-item--feature": photo.feature }]} style={`--pos: ${photo.pos}`}>
            <div class="work-media">
              <Image
                src={photo.src}
                alt={photo.caption}
                width={photo.feature ? 1200 : 640}
                widths={photo.feature ? [640, 960, 1200] : [400, 640, 960]}
                sizes={
                  photo.feature
                    ? "(min-width:1280px) 590px, (min-width:768px) 49vw, calc(100vw - 40px)"
                    : "(min-width:1280px) 285px, (min-width:768px) 24vw, calc(50vw - 26px)"
                }
                loading="lazy"
                decoding="async"
                format="webp"
              />
            </div>
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .work-item {
    margin: 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .work-media {
    border-radius: 12px;
    overflow: hidden;
    flex: 1;
    min-height: 0;
  }

  .work-media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
  }

  .work-item--feature {
    grid-column: span 2;
  }

  .work-item figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-caption);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
    }
    .work-item--feature {
      grid-row: span 2;
    }
    .work-item--feature img {
      aspect-ratio: auto;
    }
  }

  @media (min-width: 1280px) {
    .work-grid {
      gap: var(--space-5);
    }
  }
</style>
