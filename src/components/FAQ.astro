---
const faqs = [
  {
    question: "How fast do you respond to a text or estimate request?",
    answer:
      "We reply fast — text is the quickest way to reach us, since it's Helena answering, not a call center.",
  },
  {
    question: "How do I pay?",
    answer:
      "We accept cash, check, and Zelle. Payment details are confirmed when we schedule your visit.",
  },
  {
    question: "What's included in a standard cleaning?",
    answer:
      "Kitchens, bathrooms, living areas, and bedrooms — dusting, vacuuming, mopping, and sanitizing high-touch surfaces. Let us know about any specific areas or requests when you send your photo or video.",
  },
  {
    question: "Do I need to be home during the cleaning?",
    answer:
      "No — many of our recurring clients aren't home. We'll work out access details together before your first visit.",
  },
  {
    question: "What if I want to change my cleaning schedule?",
    answer:
      "Just text us. We'll adjust your recurring schedule whenever your needs change.",
  },
];
---

<section id="faq" class="faq section section-alt">
  <div class="container container-narrow">
    <div class="section-heading">
      <p class="eyebrow">Questions</p>
      <h2>Frequently Asked Questions</h2>
    </div>
    <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary>
              <span>{faq.question}</span>
              <svg class="faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item {
    background: transparent;
    border: 0;
  }

  .faq-item + .faq-item {
    border-top: 1px solid var(--color-line);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    min-height: 3.5rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--color-primary);
    transition: color var(--duration) var(--ease);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover,
  .faq-item[open] summary {
    color: var(--color-accent-strong);
  }

  .faq-item summary:focus-visible {
    outline-offset: -3px;
  }

  .faq-chevron {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--color-accent-strong);
    transition: transform var(--duration) var(--ease);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-item > p {
    padding: 0 0 var(--space-5);
    margin: 0;
    color: var(--color-text-muted);
    max-width: var(--prose-max);
  }
</style>
