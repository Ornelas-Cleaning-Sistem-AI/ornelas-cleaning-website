---
import { SERVICE_AREA_CITIES } from "../lib/service-area";
---

<section id="service-area" class="service-area section">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Where We Work</p>
      <h2>Serving Boston and the North Shore</h2>
      <p class="lead text-muted">
        We keep our coverage area tight on purpose — it's how the same team can
        show up for every visit. Here's where we clean:
      </p>
    </div>
    <ul class="city-list">
      {
        SERVICE_AREA_CITIES.map((city) => (
          <li>
            <svg class="pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M12 21s-6.5-5.4-6.5-11a6.5 6.5 0 0 1 13 0c0 5.6-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.5"/>
            </svg>
            <span>{city}</span>
          </li>
        ))
      }
    </ul>
    <p class="service-area-note">
      Not sure if your address is covered? Text us and we'll let you know.
    </p>
  </div>
</section>

<style>
  .city-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3) var(--space-4);
    max-width: 40rem;
    margin-block: var(--space-8);
  }

  .city-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
    min-height: 2rem;
  }

  .pin {
    width: 18px;
    height: 18px;
    flex: none;
    color: var(--color-accent-strong);
  }

  .service-area-note {
    font-weight: 500;
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .city-list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4) var(--space-8);
    }
  }
</style>
