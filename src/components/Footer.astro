---
import { Image } from "astro:assets";
import logoDark from "../assets/brand/logo-on-dark.png";
import { SERVICE_AREA_CITIES } from "../lib/service-area";
import { PHONE_DISPLAY, PHONE_TEL, EMAIL } from "../lib/site";

const year = new Date().getFullYear();

const quickLinks = [
  { label: "Services", href: "#services" },
  { label: "Our Work", href: "#gallery" },
  { label: "Reviews", href: "#reviews" },
  { label: "About", href: "#about" },
  { label: "How It Works", href: "#how-it-works" },
  { label: "Service Area", href: "#service-area" },
  { label: "FAQ", href: "#faq" },
  { label: "Get a Quote", href: "#estimate" },
];
---

<footer class="site-footer surface-primary">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Image
          src={logoDark}
          alt="Ornelas Cleaning"
          width={280}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
          format="webp"
        />
        <p class="footer-contact">
          <a href={PHONE_TEL} class="phone">{PHONE_DISPLAY}</a>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
      </div>

      <div>
        <p class="footer-heading">Proudly serving</p>
        <p class="footer-cities text-small text-muted">{SERVICE_AREA_CITIES.join(" · ")}</p>
      </div>

      <nav aria-label="Footer">
        <p class="footer-heading">Quick links</p>
        <ul class="footer-links">
          {quickLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="text-small text-muted">
        © {year} Ornelas Cleaning. Family-run, personally handled by Helena
        Ornelas and her husband.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    padding-block: var(--space-16) var(--space-8);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: var(--space-10);
    }
  }

  .footer-brand img {
    height: 48px;
    width: auto;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: var(--space-5);
  }

  .footer-contact a {
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-1);
    min-height: 44px;
    color: var(--color-on-primary);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }

  .footer-contact a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .footer-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    margin: 0 0 var(--space-3);
  }

  .footer-cities {
    line-height: 1.7;
    max-width: 22rem;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--color-on-primary);
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  .footer-bottom {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
</style>
