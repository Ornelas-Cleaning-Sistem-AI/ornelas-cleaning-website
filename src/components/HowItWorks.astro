---
const steps = [
  {
    title: "Send a Photo or Video",
    description:
      "Show us the space you'd like cleaned — a quick photo or video is all it takes to get started.",
  },
  {
    title: "Get Your Estimate",
    description:
      "Helena reviews it personally and sends you a straightforward estimate — no guesswork, no pressure.",
  },
  {
    title: "Book Your First Cleaning",
    description: "Pick a date that works for you and we'll take care of it.",
  },
  {
    title: "Go Recurring",
    description:
      "Like what you see? Move to a biweekly or monthly schedule with the same team, every time.",
  },
];
---

<section id="how-it-works" class="how-it-works section section-alt">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">How It Works</p>
      <h2>From First Estimate to Recurring Care</h2>
    </div>
    <ol class="steps-list">
      {
        steps.map((step, index) => (
          <li class="step">
            <span class="step-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="step-body">
              <h3>{step.title}</h3>
              <p class="text-muted">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    position: relative;
  }

  .step {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: var(--space-4);
    position: relative;
  }

  .step-number {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-step-number);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent-strong);
    position: relative;
    z-index: 1;
    width: fit-content;
  }

  .step:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 1.5rem;
    top: calc(var(--text-step-number) + var(--space-2));
    bottom: calc(-1 * var(--space-8) + var(--space-2));
    border-left: 2px dashed rgba(11, 74, 139, 0.22);
  }

  .step-body p {
    margin: 0;
  }

  @media (min-width: 1024px) {
    .steps-list {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-8);
    }

    .steps-list::before {
      content: "";
      position: absolute;
      left: 0;
      right: 20%;
      top: calc(var(--text-step-number) / 2);
      border-top: 2px dashed rgba(11, 74, 139, 0.22);
    }

    .step {
      display: flex;
      flex-direction: column;
    }

    .step:not(:last-child)::after {
      display: none;
    }

    .step-number {
      background: var(--color-surface-alt);
      padding-right: var(--space-3);
    }

    .step h3 {
      margin-top: var(--space-4);
    }
  }
</style>
