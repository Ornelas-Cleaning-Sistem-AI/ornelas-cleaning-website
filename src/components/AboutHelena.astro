---
import { Image } from "astro:assets";
import logoLight from "../assets/brand/logo-on-light.png";
---

<section id="about" class="about section">
  <div class="container about-inner">
    <div class="about-copy">
      <p class="eyebrow">Who's Cleaning Your Home</p>
      <h2>It's Helena, Not a Call Center</h2>
      <p class="lead">
        Ornelas Cleaning is run by Helena Ornelas and her husband — no
        franchise, no dispatcher, no rotating list of strangers. Helena
        personally handles every estimate, and the same trusted team shows up
        for every visit after that.
      </p>
      <p class="lead">
        That's what "you're in good hands" means to us: a real person who
        knows your home, your preferences, and your schedule — visit after
        visit.
      </p>
    </div>

    <!--
      Photo slot. When a real photo of Helena and her husband is available,
      replace the fallback below with:
        <div class="about-photo">
          <Image src={helenaPhoto} alt="Helena Ornelas and her husband" width={880} ... />
        </div>
      and style .about-photo { aspect-ratio: 4/5; border-radius: var(--radius-card);
      overflow: hidden; box-shadow: var(--shadow-md); }
      No stock photo of a couple, ever.
    -->
    <div class="about-visual" aria-hidden="true">
      <Image src={logoLight} alt="" width={640} densities={[1, 2]} loading="lazy" decoding="async" format="webp" />
    </div>
  </div>
</section>

<style>
  .about-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .about-copy .lead {
    margin-top: var(--space-4);
  }

  .about-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    background: radial-gradient(circle at 50% 42%, #ffffff 0%, #f5f8fb 70%);
  }

  .about-visual img {
    width: 60%;
    height: auto;
  }

  @media (min-width: 1024px) {
    .about-inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-16);
    }
    .about-visual {
      aspect-ratio: 4 / 5;
    }
  }
</style>
