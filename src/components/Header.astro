---
const PHONE_TEL = "tel:+16178675878";
const PHONE_SMS = "sms:+16178675878";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">Ornelas Cleaning</a>
    <nav class="header-actions" aria-label="Quick contact">
      <a class="btn btn-secondary header-btn" href={PHONE_SMS}>
        Text Us
      </a>
      <a class="btn btn-primary header-btn" href={PHONE_TEL}>
        Call (617) 867-5878
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-white);
    border-bottom: 1px solid rgba(27, 75, 102, 0.12);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    gap: 0.5rem;
  }

  .header-btn {
    padding: 0.6rem 0.9rem;
    font-size: 0.85rem;
    min-height: 40px;
  }

  @media (min-width: 480px) {
    .header-btn {
      font-size: 0.95rem;
      padding: 0.7rem 1.1rem;
    }
  }
</style>
