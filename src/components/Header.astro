---
import { Image } from "astro:assets";
import logoLight from "../assets/brand/logo-on-light.png";
import { PHONE_DISPLAY, PHONE_TEL, EMAIL } from "../lib/site";

const nav = [
  { label: "Services", href: "#services" },
  { label: "Our Work", href: "#gallery" },
  { label: "Reviews", href: "#reviews" },
  { label: "About", href: "#about" },
  { label: "FAQ", href: "#faq" },
];
---

<div class="top-bar surface-primary">
  <div class="container top-bar-inner">
    <a href={PHONE_TEL} class="top-bar-link phone">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.8.7a2 2 0 0 1 1.7 2Z"/>
      </svg>
      <span>{PHONE_DISPLAY}</span>
    </a>
    <a href={`mailto:${EMAIL}`} class="top-bar-link">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3 7 9 6 9-6"/>
      </svg>
      <span class="top-bar-email-short">Email us</span>
      <span class="top-bar-email-full">{EMAIL}</span>
    </a>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <Image
        src={logoLight}
        alt="Ornelas Cleaning"
        width={300}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
        format="webp"
      />
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav-list">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-primary btn--sm header-cta" href="#estimate">Get a Quote</a>
  </div>
</header>

<style>
  .top-bar {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .top-bar-inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 36px;
  }

  .top-bar-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-on-primary);
    text-decoration: none;
    min-height: 36px;
  }

  .top-bar-link:hover span {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .top-bar-link .icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-accent);
  }

  .top-bar-email-full {
    display: none;
  }

  @media (min-width: 768px) {
    .top-bar-email-short {
      display: none;
    }
    .top-bar-email-full {
      display: inline;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-white);
    border-bottom: 1px solid rgba(11, 74, 139, 0.08);
  }

  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-elev linear both;
      animation-timeline: scroll(root);
      animation-range: 0 48px;
    }
  }

  @keyframes header-elev {
    from {
      box-shadow: none;
    }
    to {
      box-shadow: var(--shadow-sm);
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-2);
    flex: none;
  }

  .brand img {
    height: 40px;
    width: auto;
  }

  .site-nav {
    display: none;
    margin-left: auto;
  }

  .site-nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .site-nav-list a {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3);
    font-size: var(--text-nav);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    min-height: 2.75rem;
  }

  .site-nav-list a:hover {
    color: var(--color-accent-strong);
    text-decoration: underline 2px;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 6px;
  }

  .header-cta {
    margin-left: auto;
    flex: none;
  }

  @media (min-width: 1024px) {
    .header-inner {
      min-height: 88px;
    }
    .brand img {
      height: 52px;
    }
    .site-nav {
      display: block;
    }
    .header-cta {
      margin-left: 0;
    }
  }
</style>
